<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS code-signing entitlements (applied with the hardened runtime, which notarization requires).
  The engine sidecar is a PyInstaller onefile binary: at launch it unpacks libpython + extension
  modules into a temp dir and dlopen()s them. Under the hardened runtime, library validation rejects
  those (ad-hoc / different signer) and the engine dies before printing anything — so disable it.
  Python's ctypes / some C extensions also need writable-executable memory.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
