{"schema_version": "demo-1.0", "recorder_version": "demo-1.0", "event_id": "event_0017", "episode_id": "episode_sample_0001", "session_id": "session_sample_0001", "global_sequence": 17, "kind": "AI_RESPONSE", "evidence_grade": "OBSERVED", "observed_at": "2026-05-14T09:01:59.000Z", "provider": "CHATGPT", "chars": 163, "full_text_present": true, "completion_state": "COMPLETE", "text": "One-sentence summary: Photosynthesis uses sunlight, water and carbon dioxide to build sugar and release oxygen, with the oxygen coming from the splitting of water.", "previous_hash": "4af0b316d37ed06e5c7602f3023b9cc9e37393ffc491030d5ffa0a5780cb2d01", "event_hash": "f2e220c0612e0dc56ad4eec11b9b2b46b0825fa34947c0746941f60f169701e1"}
